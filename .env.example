# ─── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Ask Me"

# ─── Supabase ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ACCESS_TOKEN=your-access-token   # for MCP server

# ─── AI Provider ─────────────────────────────────────────────────────
# Options: ollama | openai | anthropic
AI_PROVIDER=ollama

# Ollama (local dev)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# OpenAI (production option)
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# Anthropic / Claude (production option)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@askme.app
RESEND_FROM_NAME="Ask Me"

# ─── Security ────────────────────────────────────────────────────────
WEBHOOK_SECRET=your-webhook-secret

# ─── Feature Flags ───────────────────────────────────────────────────
NEXT_PUBLIC_FEATURE_INTERVIEW_REQUESTS=true
NEXT_PUBLIC_FEATURE_ANALYTICS=false
